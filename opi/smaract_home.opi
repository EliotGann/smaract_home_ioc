<?xml version="1.0" encoding="UTF-8"?>
<display typeId="org.csstudio.opibuilder.Display" version="1.0.0">
  <macros>
    <include_parent_macros>true</include_parent_macros>
    <P>XF:12IDC-ES:SMARACT_HOME:</P>
    <X_MOTOR>XF:12ID2C-ES{MCS:2-Ax:3}Mtr</X_MOTOR>
    <WBSX_MOTOR>XF:12ID2C-ES{MCS:2-Ax:1}Mtr</WBSX_MOTOR>
  </macros>
  <name>SmarAct Home IOC</name>
  <width>900</width>
  <height>600</height>
  <background_color>
    <color red="245" green="247" blue="250" />
  </background_color>
  <show_close_button>true</show_close_button>
  <grid_space>6</grid_space>
  <show_grid>false</show_grid>
  <snap_to_geometry>true</snap_to_geometry>

  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>Title</name>
    <x>20</x>
    <y>14</y>
    <width>420</width>
    <height>34</height>
    <text>SmarAct Homing</text>
    <font>
      <fontdata fontName="Liberation Sans" height="22" style="1" />
    </font>
    <foreground_color>
      <color red="18" green="43" blue="75" />
    </foreground_color>
    <transparent>true</transparent>
  </widget>

  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>PrefixLabel</name>
    <x>20</x>
    <y>52</y>
    <width>860</width>
    <height>22</height>
    <text>IOC prefix: $(P)</text>
    <transparent>true</transparent>
  </widget>

  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>StateHeader</name>
